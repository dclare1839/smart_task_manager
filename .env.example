# Anthropic (Claude) API key. Without this, the app still runs using a
# simple keyword-based fallback for categorization and briefings.
ANTHROPIC_API_KEY=your_api_key_here

# Optional: override the model used for briefing prose.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: override the fast model used for task/event categorization —
# runs on every add, so a quick model keeps that step from feeling slow.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Required before exposing this app beyond localhost (LAN, tunnel, port
# forward, etc). If left blank, the app runs with no login — fine only for
# localhost-only use.
APP_USERNAME=
APP_PASSWORD=

# Optional: Google Calendar (read-only) sync. From a Google Cloud OAuth 2.0
# Client — see README "Google 캘린더 연동" section for setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
